#!/usr/bin/ash
# mkinitcpio runtime hook: deathstr0ke pre-boot LUKS unlock manager.
# Runs in early userspace BEFORE the encrypt hook. Parses cryptdevice= like the stock encrypt hook,
# mounts the unencrypted ESP (for the persistent counter + duress verifier), and hands off to
# ds-unlock, which does the prompt/duress/attempt-limit and opens the LUKS device itself. On success
# /dev/mapper/<name> exists, so a following encrypt hook detects it and skips its own prompt.

run_hook() {
    # only act when the cmdline actually asks for an encrypted root
    [ -n "$cryptdevice" ] || return 0
    # The marker is baked into the initramfs by dsctl arm. If absent, this installed-but-inert hook
    # leaves the stock encrypt path untouched. If present, every missing/corrupt dependency is fatal.
    [ -f /etc/arxos/deathstroke/ARMED ] || return 0
    [ -f /etc/arxos/deathstroke/DISPOSABLE_MACHINE_OK_TO_DESTROY ] || deathstroke_halt "authorization marker missing"

    # cryptdevice=device:dmname[:options]  (same grammar as the encrypt hook)
    local cdev dmname
    cdev="${cryptdevice%%:*}"
    dmname="${cryptdevice#*:}"; dmname="${dmname%%:*}"
    [ -n "$dmname" ] || dmname="cryptroot"

    # resolve UUID=/PARTUUID=/LABEL= forms to a node (encrypt relies on udev having populated these)
    local resolved
    resolved="$(resolve_device "$cdev" 30)" || resolved="$cdev"

    # already opened by a prior hook? nothing to do.
    if [ -e "/dev/mapper/$dmname" ]; then
        return 0
    fi

    # find + mount the ESP read-write (the counter must be updatable and fsync'd)
    local esp_dev esp_mnt="/ds-esp"
    esp_dev="$(find_esp)"
    [ -n "$esp_dev" ] || deathstroke_halt "armed ESP not found"
    mkdir -p "$esp_mnt"
    mount -t vfat -o rw "$esp_dev" "$esp_mnt" 2>/dev/null ||
        mount "$esp_dev" "$esp_mnt" 2>/dev/null || deathstroke_halt "armed ESP mount failed"
    [ -f "$esp_mnt/deathstroke/armed" ] || deathstroke_halt "ESP armed marker missing"

    if [ ! -x /usr/bin/ds-unlock ]; then
        deathstroke_halt "ds-unlock missing while armed"
    fi

    # hand off. ds-unlock prompts, enforces duress/attempt-limit against the ESP state, and on the
    # correct passphrase runs `cryptsetup open <dev> <name>` itself.
    ds-unlock --device "$resolved" --map-name "$dmname" --esp-dir "$esp_mnt/deathstroke"
    local rc=$?
    sync
    if [ "$rc" -eq 0 ] && [ -e "/dev/mapper/$dmname" ]; then
        umount "$esp_mnt" 2>/dev/null || true
        return 0
    fi
    deathstroke_halt "armed unlock/erase path failed (rc=$rc)"
}

deathstroke_halt() {
    echo ""
    echo "DEATHSTROKE FAIL-CLOSED: $*"
    echo "Use offline recovery media and the enrolled recovery key. Standard unlock is disabled."
    sync
    poweroff -f 2>/dev/null || reboot -f 2>/dev/null || true
    while :; do sleep 86400; done
}

# Best-effort ESP locator: prefer the ARXOS-labelled EFI partition (set by the installer), then any
# partition already carrying the deathstroke state dir, then the first FAT partition.
find_esp() {
    if [ -e /dev/disk/by-partlabel/ARXOS_EFI ]; then
        echo /dev/disk/by-partlabel/ARXOS_EFI; return 0
    fi
    local d first_fat=""
    mkdir -p /ds-probe
    for d in $(blkid -o device 2>/dev/null); do
        case "$(blkid -o value -s TYPE "$d" 2>/dev/null)" in
            vfat|msdos)
                # a FAT with our state dir wins outright
                if mount -t vfat -o ro "$d" /ds-probe 2>/dev/null; then
                    if [ -d /ds-probe/deathstroke ]; then umount /ds-probe 2>/dev/null; echo "$d"; return 0; fi
                    umount /ds-probe 2>/dev/null
                fi
                [ -z "$first_fat" ] && first_fat="$d"
                ;;
        esac
    done
    [ -n "$first_fat" ] && { echo "$first_fat"; return 0; }
    return 1
}

# vim: set ft=sh ts=4 sw=4 et:
