# Dormant template. Not enabled by default; `dsctl arm` enables it when the dead-man switch is armed.
# Periodically runs the dead-man check so an isolated (offline/airplane-mode) machine still wipes if
# the user never checks in. Pairs with deathstroke-deadman.service.
[Unit]
Description=DEATHSTROKE dead-man check

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
