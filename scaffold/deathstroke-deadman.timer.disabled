# Dormant packaging template. It is not installed or enabled by `dsctl arm`; packaging must opt in.
# Periodically runs the dead-man check so an isolated (offline/airplane-mode) machine still destroys
# its recorded daily slot if the user never checks in. Pairs with deathstroke-deadman.service.
[Unit]
Description=DEATHSTROKE dead-man check

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
