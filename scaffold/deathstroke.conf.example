# Config schema example. This is the shape dsctl reads and writes at
# /etc/arxos/deathstroke/deathstroke.conf. It is a reference; nothing reads this .example file.
# dsctl owns the real file. It never stores the duress code, only a salted hash, which lives in the
# state dir, not here. File mode is 0700 root:root (dsctl enforces).

# armed: is the tool active? When false, nothing is in the auth path and no trigger can fire.
# Only `dsctl arm` sets true (and inserts the PAM line at that moment); `dsctl disarm` reverses it.
armed = false

# trigger surface. All opt-in, all default off.
trigger.duress_password = false   # a code at the unlock/login prompt. Never grants a session.
trigger.panic_command   = false   # the panic command.
trigger.hotkey_chord    = false   # an armed hotkey chord.
trigger.tamper_usb      = false   # unexpected new USB mass-storage while armed.

# duress secret: stored as a hash only, in the state dir, never here, never plaintext.
#   /var/lib/arxos/deathstroke/duress.hash  =  pbkdf2_sha256$<iter>$<salt_hex>$<hash_hex>
# these two lines only record the scheme and params for verification, never the code.
duress.kdf = pbkdf2-sha256
duress.iterations = 600000

# keyslot metadata. The keys themselves are never stored; the user holds them.
# `dsctl enroll-recovery` proves which slot each credential opens before recording these values.
daily.keyslot    = -1             # normal unlock credential; product triggers destroy only this slot.
recovery.keyslot = -1             # offline recovery credential; product triggers preserve this slot.
recovery.device  = ""             # canonical LUKS device containing both verified slots.

# crypto-erase behaviour. Recovery-safe daily-slot destruction is the product default. An operator
# can request full LUKS erase only with the separate explicit `--mode erase --destroy-recovery` pair.
erase.mode = killslot
erase.journal = /boot/efi/deathstroke/inprogress
# Only backups inside the explicitly configured ESP scan root are removed. Unknown/offline copies
# cannot be discovered or guaranteed destroyed, and SSD/flash overwrite semantics are device-specific.
erase.destroy_known_header_backups = true
erase.zero_ram_masterkey = true

# self-removal on fire: remove the tool's own artifacts (PAM line, hashes, this config) as an early
# phase, so a completed run leaves no trace that a duress setup existed on the imaged drive.
onfire.remove_artifacts = true
