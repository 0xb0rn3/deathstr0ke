# Dormant template. Not installed or enabled by default; `dsctl arm` enables it.
# It provides the power-loss resume behaviour: on every boot, check the on-disk in-progress flag
# before mounting the encrypted root, and re-enter the erase from where it stopped if it was mid-run.
# The full guarantee also needs an initramfs hook; this unit is the late-boot half.
[Unit]
Description=resume-on-boot check
DefaultDependencies=no
Before=cryptsetup.target
ConditionPathExists=/var/lib/arxos/deathstroke/in-progress

[Service]
Type=oneshot
# ds-erase --resume re-enters the crypto-erase from the journaled phase, then holds the boot.
ExecStart=/usr/lib/arxos/deathstroke/ds-erase --resume
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
